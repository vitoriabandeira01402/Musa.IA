{
  "name": "Musa.IA | Telegram + Dialogflow ES",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "b00ce000-1000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://dialogflow.googleapis.com/v2/projects/SEU_PROJECT_ID/agent/sessions/' + String($('Telegram Trigger').item.json.message.chat.id) + '-' + String($('Telegram Trigger').item.json.message.from.id) + ':detectIntent' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { queryInput: { text: { text: $('Telegram Trigger').item.json.message.text, languageCode: 'pt-BR' } } } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "b00ce000-1000-4000-8000-000000000002",
      "name": "Dialogflow ES - Detect Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ String($('Telegram Trigger').item.json.message.chat.id) }}",
        "text": "={{ $json.queryResult?.fulfillmentText || 'Não consegui interpretar essa mensagem agora. Tente falar o nome de uma música, artista ou estilo.' }}",
        "additionalFields": {}
      },
      "id": "b00ce000-1000-4000-8000-000000000003",
      "name": "Responder no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Dialogflow ES - Detect Intent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dialogflow ES - Detect Intent": {
      "main": [
        [
          {
            "node": "Responder no Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "b00ce000-1000-4000-8000-000000000004",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
